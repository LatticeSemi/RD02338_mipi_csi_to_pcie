set RX_CLOCK_PERIOD [expr {double(round(1000000/$RX_CLOCK_FREQ))/1000}]
set TX_CLOCK_PERIOD [expr {double(round(1000000/$TX_CLOCK_FREQ))/1000}]
set AXI_CLOCK_PERIOD [expr {double(round(1000000/$AXI_CLOCK_FREQ))/1000}]

create_clock -name {awb_top_inst/axis_rx_clk_i} -period $RX_CLOCK_PERIOD [get_ports axis_rx_clk_i]
create_clock -name {awb_top_inst/axis_tx_clk_i} -period $TX_CLOCK_PERIOD [get_ports axis_tx_clk_i]
create_clock -name {axi_lite_clk_i} -period $AXI_CLOCK_PERIOD [get_ports axi_lite_clk_i]

set_clock_groups -group [get_clocks axi_lite_clk_i] -group [get_clocks awb_top_inst/axis_rx_clk_i] -group [get_clocks awb_top_inst/axis_tx_clk_i] -asynchronous


#create_clock -name {axi_lite_clk_i} -period 10 [get_ports axi_lite_clk_i]
#create_clock -name {awb_top_inst/axis_rx_clk_i} -period 5 [get_ports axis_rx_clk_i]
#create_clock -name {awb_top_inst/axis_tx_clk_i} -period 5 [get_ports axis_tx_clk_i]


set_false_path -from [get_clocks awb_top_inst/axis_tx_clk_i] -to [get_clocks awb_top_inst/axis_rx_clk_i]
set_false_path -from [get_clocks axi_lite_clk_i] -to [get_clocks awb_top_inst/axis_rx_clk_i]

set_false_path -from [get_clocks awb_top_inst/axis_rx_clk_i] -to [get_clocks awb_top_inst/axis_tx_clk_i]

set_false_path -from [get_clocks awb_top_inst/axis_rx_clk_i] -to [get_clocks axi_lite_clk_i]

#----- VIRTUAL IOS
#      Below ports are usually not brought as top-level ports in system-level
#      applications and set as Virtual IOs to pass Map for evaluation purposes.


ldc_set_attribute {VIRTUAL_IO=TRUE} [get_ports {ar_address_i[0]}]

# Current target is set to 150MHz. Update as deemed necessary.


# Update target frequency to pass timing


if {$isp_awb_FAMILY == "LAV-AT" || $isp_awb_FAMILY == "LN2-CT"} {
	if {$isp_awb_speed == "3"} {
		set RX_CLOCK_FREQ "190"
		set TX_CLOCK_FREQ "200"
		set AXI_CLOCK_FREQ "200"
	} else {
		set RX_CLOCK_FREQ "170"
		set TX_CLOCK_FREQ "200"
		set AXI_CLOCK_FREQ "200"
	}

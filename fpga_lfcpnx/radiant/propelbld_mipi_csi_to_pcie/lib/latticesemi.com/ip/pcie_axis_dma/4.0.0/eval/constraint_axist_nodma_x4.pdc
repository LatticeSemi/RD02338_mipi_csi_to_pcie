##CLOCK constraints
#create_clock -name {link0_clk_usr_o_c} -period 4 [get_pins lscc_pcie_x4_inst.gen_ahbtop.u_pcie_x4x1_ahblapb_top.u_pcie_x4x1_default_top.gen_primitive.u_pcie_x4_prim_inst.u_PCIELL_pcs_merge_pcs_merge_pcs_merge_pcs_merge.PCIELL_inst/LINK0_CKUSRO]
#create_clock -name {clk_usr_i} -period 4 [get_ports sys_clk_i]
#create_clock -name {clk_usr_div2_i} -period 8 [get_ports clk_usr_div2_i]
create_clock -name {clk_usr_ps90_i} -period 4 [get_ports clk_usr_ps90_i]
create_clock -name {c_apb_pclk_i} -period 10 [get_ports c_apb_pclk_i]
create_clock -name {refclkp_i} -period 10 [get_ports refclkp_i]
create_clock -name {refclkn_i} -period 10 [get_ports refclkn_i]
##CDC constraint
set_clock_groups -group [get_clocks sys_clk_i] -group [get_clocks c_apb_pclk_i] -asynchronous
set_clock_groups -group [get_clocks clk_usr_div2_i] -group [get_clocks c_apb_pclk_i] -asynchronous
set_clock_groups -group [get_clocks sys_clk_i] -group [get_clocks clk_usr_div2_i] -asynchronous
set_clock_groups -group [get_clocks clk_usr_ps90_i] -group [get_clocks clk_usr_div2_i] -asynchronous
####  Only Gen3 requires clk_usr_ps90; thus this is the only one that requires MCP constraint applied
## multicycle path
set_multicycle_path -setup -from [get_clocks sys_clk_i] -to [get_clocks clk_usr_ps90_i] 2
set_multicycle_path -hold -from [get_clocks sys_clk_i] -to [get_clocks clk_usr_ps90_i] 1
## MPW ##
ldc_set_port -iobuf {IO_TYPE=LVDS} [get_ports sys_clk_i]
##Virtual IOs
ldc_set_attribute {VIRTUAL_IO=TRUE} [get_ports {link0_rxp_i[*]}]

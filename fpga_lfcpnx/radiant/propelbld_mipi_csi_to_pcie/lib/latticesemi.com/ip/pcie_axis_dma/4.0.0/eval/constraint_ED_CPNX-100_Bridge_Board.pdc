ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports linkup_done]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports clock_flag]

## Change to DIP switch
ldc_set_location -site {J21} [get_ports {usr_int_req_i_n_button[0]}]
ldc_set_location -site {K20} [get_ports {usr_int_req_i_n_button[1]}]
ldc_set_location -site {K24} [get_ports {usr_int_req_i_n_button[2]}]
ldc_set_location -site {J25} [get_ports {usr_int_req_i_n_button[3]}]

create_clock -name {refclkp_i} -period 10 [get_ports refclkp_i]
create_clock -name {refclkn_i} -period 10 [get_ports refclkn_i]

create_clock -name {usr_lmmi_clk_i} -period 20 [get_pins {ep_OSC.OSCA_inst/HFCLKOUT }]
set_clock_groups -group [get_clocks clk_usr_i_125MHz] -group [get_clocks usr_lmmi_clk_i] -asynchronous


ldc_set_location -site {SDQ0_REFCLKP} [get_ports refclkp_i]
ldc_set_location -site {SDQ0_REFCLKN} [get_ports refclkn_i]

create_clock -name {clk_user} -period 8 [get_ports clk_user]
ldc_set_location -site {P24} [get_ports clk_user]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports ed_usr_rst_n]
###ldc_set_location -site {N9} [get_ports ed_usr_rst_n]
ldc_set_location -site {M3} [get_ports ed_usr_rst_n]

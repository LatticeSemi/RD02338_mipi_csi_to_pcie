ldc_set_location -site {SDQ0_REFCLKP} [get_ports refclkp_i]
ldc_set_location -site {SDQ0_REFCLKN} [get_ports refclkn_i]
create_clock -name {refclkp_i} -period 10 [get_ports refclkp_i]
create_clock -name {refclkn_i} -period 10 [get_ports refclkn_i]
ldc_set_location -site {SD0_RXDP} [get_ports {link0_rxp_i[0]}]
ldc_set_location -site {SD0_RXDN} [get_ports {link0_rxn_i[0]}]
ldc_set_location -site {SD0_TXDP} [get_ports {link0_txp_o[0]}]
ldc_set_location -site {SD0_TXDN} [get_ports {link0_txn_o[0]}]
# Please comment this section out if you are using the 1x1 configuration
# Commenting is done with the hashtag symbol
# Section Start
ldc_set_location -site {SD1_RXDP} [get_ports {link0_rxp_i[1]}]
ldc_set_location -site {SD1_RXDN} [get_ports {link0_rxn_i[1]}]
ldc_set_location -site {SD1_TXDP} [get_ports {link0_txp_o[1]}]
ldc_set_location -site {SD1_TXDN} [get_ports {link0_txn_o[1]}]
# Section End
# Please comment this section out if you are using the 1x2 and 1x1 configuration
# Commenting is done with the hashtag symbol
# Section Start
ldc_set_location -site {SD2_RXDP} [get_ports {link0_rxp_i[2]}]
ldc_set_location -site {SD2_RXDN} [get_ports {link0_rxn_i[2]}]
ldc_set_location -site {SD2_TXDP} [get_ports {link0_txp_o[2]}]
ldc_set_location -site {SD2_TXDN} [get_ports {link0_txn_o[2]}]
ldc_set_location -site {SD3_RXDP} [get_ports {link0_rxp_i[3]}]
ldc_set_location -site {SD3_RXDN} [get_ports {link0_rxn_i[3]}]
ldc_set_location -site {SD3_TXDP} [get_ports {link0_txp_o[3]}]
ldc_set_location -site {SD3_TXDN} [get_ports {link0_txn_o[3]}]
# Section End
# Resets for the system
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports ed_usr_rst_n]
ldc_set_location -site {M3} [get_ports ed_usr_rst_n]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports ed_perst_n_i]
ldc_set_location -site {R26} [get_ports ed_perst_n_i]
# Clock being supplied into the system from a clock source found in the LFCPNX Bridge Board
create_clock -name {clk_user} -period 8 [get_ports clk_user]
ldc_set_location -site {P24} [get_ports clk_user]
# Other example design ports
ldc_set_location -site {AF25} [get_ports pcie_sel]
ldc_set_location -site {AB25} [get_ports clk_sel]
ldc_set_location -site {SD0_REFRET} [get_ports {refret_i[0]}]
ldc_set_location -site {SD1_REFRET} [get_ports {refret_i[1]}]
ldc_set_location -site {SD2_REFRET} [get_ports {refret_i[2]}]
ldc_set_location -site {SD3_REFRET} [get_ports {refret_i[3]}]
ldc_set_location -site {SD0_REXT} [get_ports {rext_i[0]}]
ldc_set_location -site {SD1_REXT} [get_ports {rext_i[1]}]
ldc_set_location -site {SD2_REXT} [get_ports {rext_i[2]}]
ldc_set_location -site {SD3_REXT} [get_ports {rext_i[3]}]
ldc_set_location -site {T6} [get_ports pcie_sw1_pd]
ldc_set_location -site {T5} [get_ports pcie_sw2_pd]
ldc_set_location -site {R5} [get_ports linkup_done]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports linkup_done]
#ldc_set_location -site {R4} [get_ports clock_flag]
#ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports clock_flag]
ldc_create_group -name TX_2STG -bbox {3 30} [get_cells {LFCPNX_Enhanced_Application_Layer.application_layer_inst/W_TLP_ADAPTER.tx_2_to_1/tx_pipestg_2 }]
ldc_set_location -site {R2C2D} [ldc_get_groups TX_2STG]
ldc_create_group -name TX_4STG -bbox {3 30} [get_cells {LFCPNX_Enhanced_Application_Layer.application_layer_inst/W_TLP_ADAPTER.tx_2_to_1/tx_pipestg }]
ldc_set_location -site {R5C2D} [ldc_get_groups TX_4STG]
ldc_create_group -name TX_DC_FIFO -bbox {3 30} [get_cells {LFCPNX_Enhanced_Application_Layer.application_layer_inst/W_TLP_ADAPTER.tx_2_to_1/TLP_INTF_128.tx_tlp_dc_fifo_inst0 LFCPNX_Enhanced_Application_Layer.application_layer_inst/W_TLP_ADAPTER.tx_2_to_1/TLP_INTF_128.tx_tlp_dc_fifo_inst1 }]
ldc_set_location -site {EBR_CORE_R10C2} [ldc_get_groups TX_DC_FIFO]
ldc_create_group -name DATA_FLOP2 -bbox {1 30} [get_cells {LFCPNX_Enhanced_Application_Layer.application_layer_inst/W_TLP_ADAPTER.tx_2_to_1/tx_dcfifo_data_flop2 }]
ldc_set_location -site {R8C2D} [ldc_get_groups DATA_FLOP2]
ldc_create_group -name PCIE_RX_1TO2 -bbox {11 41} [get_cells {LFCPNX_Enhanced_Application_Layer.application_layer_inst/W_TLP_ADAPTER.rx_1_to_2 LFCPNX_Enhanced_Application_Layer.ucfg_app_inst}]
ldc_set_location -site {R2C32D} [ldc_get_groups PCIE_RX_1TO2]

create_clock -name {usr_lmmi_clk_i} -period 20 [get_pins {ep_OSC.OSCA_inst/HFCLKOUT }]
#set_clock_groups -group [get_clocks sys_clk_int] -group [get_clocks usr_lmmi_clk_i] -asynchronous

set_clock_uncertainty 0.05 [get_clocks sys_clk_int]
## The below line must be commented out for Gen1 & Gen2:
set_clock_uncertainty 0.05 [get_clocks sys_clk_i]

# This constraint needed for SPI Flash Programming.
ldc_set_sysconfig {JTAG_PORT=ENABLE PROGRAMN_PORT=ENABLE BOOTMODE=SINGLE MASTER_SPI_PORT=SERIAL CONFIG_SECURE=OFF CONFIG_IOSLEW=FAST MCCLK_FREQ=56.2}

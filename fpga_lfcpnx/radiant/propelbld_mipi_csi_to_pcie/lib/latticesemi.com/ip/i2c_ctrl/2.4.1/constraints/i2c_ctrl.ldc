set device "LFCPNX-100"
set device_int "jd5d80"
set package "LFG672"
set package_int "LFG672"
set speed "9_High-Performance_1.0V"
set speed_int "12"
set operation "Commercial"
set family "LFCPNX"
set architecture "jd5d00"
set partnumber "LFCPNX-100-9LFG672C"
set WRAPPER_INST "lscc_i2c_master_inst"
set APB_ENABLE 1
set REMOVE_TRISTATE 0
set FAMILY "LFCPNX"
set FIFO_DEPTH 16
set FIFO_IMPL "LUT"
set TX_FIFO_AE_FLAG 2
set RX_FIFO_AF_FLAG 14
set SYS_CLOCK_FREQ 125
set PRESCALER 622


ldc_set_port -iobuf {PULLMODE=UP} [get_ports {scl_io}]
ldc_set_port -iobuf {PULLMODE=UP} [get_ports {sda_io}]

create_clock -name {clk_i} -period 20 [get_ports clk_i]
